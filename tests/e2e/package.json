{
  "name": "teller-bus-e2e",
  "private": true,
  "description": "End-to-end tests for the TellerBus stack running in docker compose.",
  "scripts": {
    "stack:up": "docker compose -f ../../docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -f ../../docker-compose.yml down",
    "test": "playwright test",
    "test:no-chaos": "playwright test --grep-invert @chaos",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.7.5"
  }
}
